<?xml version="1.0" encoding="utf-8"?>
<component name="ProtvScene" extends="Scene">
  <interface>
    <field id="launchRequest" type="assocarray" onChange="onLaunch" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/model.brs" />
  <script type="text/brightscript" uri="pkg:/source/firebaseConfig.brs" />
  <script type="text/brightscript" uri="ProtvScene.brs" />
  <children>
    <Rectangle width="1280" height="720" color="0x05070BFF" />
    <Poster id="background" width="1280" height="720" uri="pkg:/assets/background.jpg" loadDisplayMode="scaleToFill" />

    <!-- Home has two arrangements: "hero" (featured title, one full rail) and
         "browse" (rails focused: compact title, two full rails). browseAnim
         moves between them. -->
    <Group id="home">
      <!-- Living hero: the focused title's poster decoded at 56 x 16 and scaled
           up is a soft colour wash. Two layers crossfade. -->
      <Group id="heroLayer">
        <Poster id="backdropA" width="1280" height="360" loadWidth="56" loadHeight="16" loadDisplayMode="scaleToZoom" opacity="0" />
        <Poster id="backdropB" width="1280" height="360" loadWidth="56" loadHeight="16" loadDisplayMode="scaleToZoom" opacity="0" />
        <Poster id="heroScrim" width="1280" height="360" uri="pkg:/assets/hero-scrim.png" loadDisplayMode="scaleToFill" />
        <!-- Solid floor so the raised hero in browse mode has no seam. -->
        <Rectangle translation="[0,360]" width="1280" height="600" color="0x05070BFF" />
      </Group>
      <Group id="heroExtras">
        <Group id="heroArtwork" translation="[1040,72]" visible="false">
          <Poster uri="pkg:/assets/panel.9.png" translation="[-6,-6]" width="188" height="276" />
          <Poster uri="pkg:/assets/poster-fallback.jpg" width="176" height="264" loadDisplayMode="scaleToFill" />
          <Label text="PROtv" translation="[0,116]" width="176" height="32" horizAlign="center" color="0x60A5FAFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="24" />
          </Label>
          <Poster id="heroArt" width="176" height="264" loadWidth="176" loadHeight="264" loadDisplayMode="scaleToFit" />
          <Poster uri="pkg:/assets/panel-mask.9.png" width="176" height="264" />
        </Group>
        <Label id="heroDescription" text="Independent stories. Timeless cinema." translation="[112,210]" width="860" height="52" wrap="true" maxLines="2" color="0xD5DBE8FF">
          <Font role="font" uri="font:SystemFontFile" size="18" />
        </Label>
        <Group id="heroButtons" translation="[112,276]">
          <PillButton id="heroPlay" text="Play" style="primary" icon="play" width="140" height="48" visible="false" />
          <PillButton id="heroInfo" text="More Info" style="secondary" icon="info" width="168" height="48" translation="[160,0]" visible="false" />
          <PillButton id="heroList" text="My List" style="secondary" icon="plus" width="156" height="48" translation="[348,0]" visible="false" />
        </Group>
        <Group id="heroDots" translation="[640,297]" />
      </Group>
      <LayoutGroup id="heroCopy" translation="[112,200]" layoutDirection="vert" vertAlignment="bottom" itemSpacings="[6,6]">
        <Group id="heroEyebrowRow">
          <Rectangle translation="[0,10]" width="28" height="3" color="0x60A5FAFF" />
          <Label id="heroEyebrow" text="PROtv" translation="[40,0]" width="820" height="24" color="0xAFC8F5FF">
            <Font role="font" uri="font:BoldSystemFontFile" size="16" />
          </Label>
        </Group>
        <Label id="heroTitle" text="Welcome to PROtv" width="860" wrap="true" maxLines="2" color="0xFFFFFFFF">
          <Font role="font" uri="font:BoldSystemFontFile" size="38" />
        </Label>
        <Label id="heroMeta" width="860" height="24" color="0xC9D9F8FF">
          <Font role="font" uri="font:SystemFontFile" size="18" />
        </Label>
      </LayoutGroup>
      <Group id="railsGroup">
        <Label id="railCount" translation="[1016,354]" width="200" height="28" horizAlign="right" vertAlign="center" color="0x7D879EFF">
          <Font role="font" uri="font:SystemFontFile" size="15" />
        </Label>
        <RowList id="rails" translation="[112,352]" width="1168" height="532" itemComponentName="PosterCard" itemSize="[1168,266]" numRows="2" rowItemSize="[[120,232]]" rowHeights="[266]" rowItemSpacing="[[16,0]]" rowLabelOffset="[[0,4]]" rowLabelColor="0xE9EEF8FF" showRowLabel="[true]" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="fixedFocus" drawFocusFeedback="false">
          <Font role="rowLabelFont" uri="font:BoldSystemFontFile" size="22" />
        </RowList>
      </Group>
      <!-- Rows below the fold fade out instead of being cut off. -->
      <Poster id="bottomFade" translation="[0,620]" width="1280" height="100" uri="pkg:/assets/bottom-fade.png" loadDisplayMode="scaleToFill" />
    </Group>

    <!-- Account sits under the sidebar, like Home: the expanded sidebar draws over it.
         Everything ends above the status toast band (y 624). -->
    <Group id="account" translation="[136,0]" visible="false">
      <Label text="Your PROtv account" translation="[0,96]" width="900" height="52" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="36" />
      </Label>
      <Label id="accountMessage" translation="[0,156]" width="900" height="90" wrap="true" maxLines="3" color="0xC9D1E4FF">
        <Font role="font" uri="font:SystemFontFile" size="20" />
      </Label>
      <Label id="accountHint" translation="[0,258]" width="900" height="52" wrap="true" maxLines="2" color="0x7D879EFF">
        <Font role="font" uri="font:SystemFontFile" size="17" />
      </Label>
      <Group id="accountButtons" translation="[0,346]">
        <PillButton id="accountAction" text="Sign in" style="primary" width="200" height="48" />
        <PillButton id="accountCreate" text="Create account" style="secondary" width="220" height="48" />
        <PillButton id="accountReset" text="Forgot password" style="secondary" width="230" height="48" />
        <PillButton id="accountSignOut" text="Sign Out" style="secondary" width="160" height="48" visible="false" />
        <PillButton id="accountBack" text="Back" style="secondary" width="132" height="48" />
      </Group>
      <Label translation="[0,430]" width="900" height="66" wrap="true" maxLines="3" color="0x7D879EFF" text="Guest browsing and playback always work. This TV stays signed in until you select Sign Out. Your password is never stored on this TV. Guest Continue Watching is saved on this TV only.">
        <Font role="font" uri="font:SystemFontFile" size="15" />
      </Label>
      <!-- Installed version, for support requests. -->
      <Label id="accountBuild" translation="[0,508]" width="900" height="22" color="0x7D879EFF">
        <Font role="font" uri="font:SystemFontFile" size="14" />
      </Label>
    </Group>

    <!-- Collapsed: 88px icon rail. Focused: expands to 256px over the content. -->
    <Group id="sidebar">
      <Rectangle id="sidebarBg" width="88" height="720" color="0x070A12FF" />
      <Poster id="sidebarFade" translation="[88,0]" width="24" height="720" uri="pkg:/assets/sidebar-fade.png" loadDisplayMode="scaleToFill" />
      <Poster id="logo" translation="[14,30]" width="64" height="19" uri="pkg:/assets/logo.png" />
      <Group id="nav" translation="[20,92]">
        <PillButton id="navHome" text="Home" style="nav" icon="home" width="216" height="40" compact="true" />
        <PillButton id="navSearch" text="Search" style="nav" icon="search" width="216" height="40" compact="true" translation="[0,46]" />
        <PillButton id="navCreators" text="Creators" style="nav" icon="star" width="216" height="40" compact="true" translation="[0,92]" />
        <PillButton id="navMovies" text="Movies" style="nav" icon="film" width="216" height="40" compact="true" translation="[0,138]" />
        <PillButton id="navSeries" text="Series" style="nav" icon="tv" width="216" height="40" compact="true" translation="[0,184]" />
        <PillButton id="navBlackCinema" text="Black Cinema" style="nav" icon="clapper" width="216" height="40" compact="true" translation="[0,230]" />
        <PillButton id="navAiCinema" text="AI Cinema" style="nav" icon="sparkles" width="216" height="40" compact="true" translation="[0,276]" />
        <PillButton id="navMyList" text="My List" style="nav" icon="plus" width="216" height="40" compact="true" translation="[0,322]" />
        <PillButton id="navContinue" text="Continue" style="nav" icon="clock" width="216" height="40" compact="true" translation="[0,368]" />
        <PillButton id="navAccount" text="Account" style="nav" icon="user" width="216" height="40" compact="true" translation="[0,414]" />
      </Group>
    </Group>
    <!-- Guest / greeting: focusable (Up from the featured actions); OK opens Account. -->
    <Group id="topBar">
      <PillButton id="profileButton" text="Guest" style="ghost" icon="user" width="216" height="40" translation="[1000,22]" />
    </Group>

    <Group id="detail" visible="false">
      <Poster id="detailBackdrop" width="1280" height="560" loadWidth="56" loadHeight="24" loadDisplayMode="scaleToZoom" opacity="0.8" />
      <Poster uri="pkg:/assets/hero-scrim.png" width="1280" height="560" loadDisplayMode="scaleToFill" />
      <Poster uri="pkg:/assets/panel.9.png" translation="[52,88]" width="304" height="444" />
      <Poster id="detailFallbackArt" uri="pkg:/assets/poster-fallback.jpg" translation="[64,100]" width="280" height="420" loadDisplayMode="scaleToFill" />
      <Label id="detailFallback" translation="[84,220]" width="240" height="180" horizAlign="center" wrap="true" maxLines="5" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="24" />
      </Label>
      <Poster id="detailArt" translation="[64,100]" width="280" height="420" loadWidth="280" loadHeight="420" loadDisplayMode="scaleToFit" />
      <Poster uri="pkg:/assets/panel-mask.9.png" translation="[64,100]" width="280" height="420" />
      <Rectangle translation="[400,111]" width="28" height="3" color="0x60A5FAFF" />
      <Label id="detailEyebrow" text="NOW STREAMING ON PROtv" translation="[440,100]" width="700" height="24" color="0xAFC8F5FF">
        <Font role="font" uri="font:BoldSystemFontFile" size="17" />
      </Label>
      <Label id="detailTitle" translation="[400,132]" width="816" height="104" wrap="true" maxLines="2" vertAlign="center" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="40" />
      </Label>
      <Label id="detailMeta" translation="[400,244]" width="816" height="28" color="0xC9D9F8FF">
        <Font role="font" uri="font:SystemFontFile" size="19" />
      </Label>
      <Rectangle id="synopsisFocus" translation="[386,288]" width="3" height="214" color="0x60A5FAFF" visible="false" />
      <ScrollableText id="detailDescription" translation="[400,292]" width="780" height="206" color="0xD5DBE8FF">
        <Font role="font" uri="font:SystemFontFile" size="20" />
      </ScrollableText>
      <Group id="detailButtons" translation="[400,528]">
        <PillButton id="detailPlay" text="Play" style="primary" icon="play" width="180" height="48" />
        <PillButton id="detailList" text="My List" style="secondary" icon="plus" width="168" height="48" translation="[200,0]" />
        <PillButton id="detailBack" text="Back" style="secondary" width="132" height="48" translation="[388,0]" />
      </Group>
      <Label text="Press Up to read the full synopsis" translation="[400,600]" width="816" height="24" color="0x7D879EFF">
        <Font role="font" uri="font:SystemFontFile" size="16" />
      </Label>
    </Group>

    <!-- Series: seasons from real season numbers, then that season's episodes. -->
    <Group id="seriesScreen" visible="false">
      <Poster id="seriesBackdrop" width="1280" height="560" loadWidth="56" loadHeight="24" loadDisplayMode="scaleToZoom" opacity="0.8" />
      <Poster uri="pkg:/assets/hero-scrim.png" width="1280" height="560" loadDisplayMode="scaleToFill" />
      <Poster uri="pkg:/assets/panel.9.png" translation="[52,88]" width="304" height="444" />
      <Poster id="seriesFallbackArt" uri="pkg:/assets/poster-fallback.jpg" translation="[64,100]" width="280" height="420" loadDisplayMode="scaleToFill" />
      <Label id="seriesFallback" translation="[84,220]" width="240" height="180" horizAlign="center" wrap="true" maxLines="5" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="24" />
      </Label>
      <Poster id="seriesArt" translation="[64,100]" width="280" height="420" loadWidth="280" loadHeight="420" loadDisplayMode="scaleToFit" />
      <Poster uri="pkg:/assets/panel-mask.9.png" translation="[64,100]" width="280" height="420" />
      <Rectangle translation="[400,111]" width="28" height="3" color="0x60A5FAFF" />
      <Label text="PROtv SERIES" translation="[440,100]" width="700" height="24" color="0xAFC8F5FF">
        <Font role="font" uri="font:BoldSystemFontFile" size="17" />
      </Label>
      <Label id="seriesTitle" translation="[400,132]" width="816" height="56" maxLines="1" vertAlign="center" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="40" />
      </Label>
      <Label id="seriesMeta" translation="[400,192]" width="816" height="28" color="0xC9D9F8FF">
        <Font role="font" uri="font:SystemFontFile" size="19" />
      </Label>
      <Group id="seriesSeasons" translation="[412,244]" />
      <LabelList id="seriesEpisodes" translation="[400,316]" itemSize="[816,48]" numRows="5" itemSpacing="[0,4]" vertFocusAnimationStyle="floatingFocus" focusBitmapUri="pkg:/assets/nav-focus.9.png" color="0xC9D1E4FF" focusedColor="0xFFFFFFFF" textHorizAlign="left">
        <Font role="font" uri="font:SystemFontFile" size="20" />
        <Font role="focusedFont" uri="font:BoldSystemFontFile" size="20" />
      </LabelList>
      <Label text="Up for seasons  ·  OK opens an episode  ·  Back returns to Series" translation="[400,600]" width="816" height="24" color="0x7D879EFF">
        <Font role="font" uri="font:SystemFontFile" size="16" />
      </Label>
    </Group>

    <Poster id="statusPanel" uri="pkg:/assets/toast.9.png" translation="[390,624]" width="768" height="64" visible="false" />
    <Label id="status" translation="[426,636]" width="696" height="40" horizAlign="center" vertAlign="center" color="0xE9EEF8FF">
      <Font role="font" uri="font:SystemFontFile" size="17" />
    </Label>
    <!-- The native player UI is off; PROtv's overlay shows state. A focused
         Video node swallows OK even with enableUI="false" (TV: RC3), so focus
         goes to playerKeys, its child: PROtv's keys are caught there first, and
         Options (*) passes up to the Video node, which stays in the focus chain
         so Roku's caption overlay can open. -->
    <Video id="video" visible="false" width="1280" height="720" enableUI="false">
      <PlayerRemote id="playerKeys" />
    </Video>
    <Group id="playerOverlay" visible="false">
      <Poster uri="pkg:/assets/bottom-fade.png" translation="[0,420]" width="1280" height="300" loadDisplayMode="scaleToFill" />
      <Group id="playerPreview" visible="false">
        <Rectangle translation="[-4,-4]" width="264" height="152" color="0x05070BFF" />
        <Poster id="playerPreviewArt" width="256" height="144" loadWidth="256" loadHeight="144" loadDisplayMode="scaleToFit" />
      </Group>
      <Label id="playerTitle" translation="[112,540]" width="1056" height="36" color="0xFFFFFFFF">
        <Font role="font" uri="font:BoldSystemFontFile" size="28" />
      </Label>
      <Rectangle id="playerTrack" translation="[112,588]" width="1056" height="6" color="0xFFFFFF40" />
      <Rectangle id="playerFill" translation="[112,588]" width="0" height="6" color="0x60A5FAFF" />
      <PillButton id="playerToggle" text="Pause" style="secondary" icon="pause" width="160" height="44" translation="[112,620]" />
      <Label id="playerTime" translation="[868,626]" width="300" height="32" horizAlign="right" vertAlign="center" color="0xE9EEF8FF">
        <Font role="font" uri="font:SystemFontFile" size="20" />
      </Label>
    </Group>
    <!-- Certification 3.4: a loading indicator for waits over 3 seconds. -->
    <BusySpinner id="loadingSpinner" translation="[608,328]" visible="false" spinInterval="1.2" />
    <Animation id="backdropFade" duration="0.8" easeFunction="inOutQuad" repeat="false">
      <FloatFieldInterpolator id="fadeIn" key="[0.0, 1.0]" keyValue="[0.0, 0.85]" fieldToInterp="backdropB.opacity" />
      <FloatFieldInterpolator id="fadeOut" key="[0.0, 1.0]" keyValue="[0.85, 0.0]" fieldToInterp="backdropA.opacity" />
    </Animation>
    <Animation id="browseAnim" duration="0.35" easeFunction="inOutCubic" repeat="false">
      <Vector2DFieldInterpolator id="railsMove" key="[0.0, 1.0]" keyValue="[[0,0],[0,-200]]" fieldToInterp="railsGroup.translation" />
      <Vector2DFieldInterpolator id="heroLayerMove" key="[0.0, 1.0]" keyValue="[[0,0],[0,-210]]" fieldToInterp="heroLayer.translation" />
      <Vector2DFieldInterpolator id="heroCopyMove" key="[0.0, 1.0]" keyValue="[[112,200],[112,140]]" fieldToInterp="heroCopy.translation" />
      <Vector2DFieldInterpolator id="fadeMove" key="[0.0, 1.0]" keyValue="[[0,620],[0,688]]" fieldToInterp="bottomFade.translation" />
      <FloatFieldInterpolator id="extrasFade" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="heroExtras.opacity" />
    </Animation>
    <Animation id="sidebarAnim" duration="0.25" easeFunction="outCubic" repeat="false">
      <FloatFieldInterpolator id="sidebarWidth" key="[0.0, 1.0]" keyValue="[88.0, 256.0]" fieldToInterp="sidebarBg.width" />
      <Vector2DFieldInterpolator id="sidebarFadeMove" key="[0.0, 1.0]" keyValue="[[88,0],[256,0]]" fieldToInterp="sidebarFade.translation" />
    </Animation>
    <Timer id="progressTimer" repeat="true" duration="15.0" />
    <Timer id="statusTimer" repeat="false" duration="5.0" />
    <Timer id="rotateTimer" repeat="true" duration="8.0" />
    <Timer id="backdropTimer" repeat="false" duration="0.3" />
    <!-- Opens the email keyboard after Roku's email request screen has closed. -->
    <Timer id="authDialogTimer" repeat="false" duration="0.4" />
    <Timer id="playerHideTimer" repeat="false" duration="3.0" />
    <Timer id="seekTimer" repeat="false" duration="0.8" />
  </children>
</component>
