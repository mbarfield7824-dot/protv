{
  "installCommand": "npm ci && cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{frontend/dist/index.html,frontend/src/assets/me-and-my-white-friend-banner.png}"
    }
  },
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "<https://watchprotv.com/>; rel=\"canonical\"" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/podcast/me-and-my-white-friend",
      "destination": "/api/index?path=short-links/featured-page"
    },
    {
      "source": "/sponsors",
      "destination": "/sponsors/index.html"
    },
    {
      "source": "/sponsors/",
      "destination": "/sponsors/index.html"
    },
    {
      "source": "/title/:id",
      "destination": "/api/index?path=v1/catalog/titles/:id/html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?path=v1/catalog/sitemap.xml"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    },
    {
      "source": "/:slug([A-Za-z0-9][A-Za-z0-9-]{0,63})",
      "destination": "/api/index?path=short-links/resolve/:slug"
    },
    {
      "source": "/((?!api/|robots\\.txt$|sitemap\\.xml$).*)",
      "destination": "/index.html"
    }
  ]
}
