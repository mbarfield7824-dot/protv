# Backend Configuration
PORT=5000

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (JSON file path or inline credentials)
# Download this from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_KEY=path_to_serviceAccountKey.json
# Production/Vercel alternative: paste the complete service-account JSON into
# this protected environment variable. Do not set both credential variables.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}

# The email address of the one account allowed to activate the initial admin claim.
OWNER_EMAIL=owner@example.com

# Mux Configuration (for video streaming - will add later)
MUX_ACCESS_TOKEN=your_mux_token_here
MUX_SECRET_KEY=your_mux_secret_here

# Advertising is disabled unless both the HTTPS VAST tag and event secret are set.
VAST_AD_TAG_URL=
AD_EVENT_SIGNING_SECRET=
# HMAC secret used by the ad network's authoritative revenue-report webhook.
AD_PROVIDER_WEBHOOK_SECRET=
# Signed server-to-server Creator Agent revenue synchronization.
CREATOR_AGENT_REVENUE_URL=http://127.0.0.1:4180/api/integrations/protv/ad-revenue
CREATOR_AGENT_REVENUE_SECRET=
# Verifies Creator Agent requests that link projects to PROtv catalog titles.
PROTV_CREATOR_LINK_SECRET=
# Optional file fallback when Firebase is unavailable.
AD_REVENUE_FILE=D:\PROtv-Data\ad-revenue.json

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Short-lived signed handoff to the separate Creator Portal.
CREATOR_PORTAL_URL=http://127.0.0.1:5180
# Use the same high-entropy value as PROTV_SSO_SECRET in the Creator Agent.
CREATOR_SSO_SECRET=

# Public Domain Admin Bot
# This folder is scanned recursively for .mp4, .mkv, and .mov files.
PD_CONTENT_DIRECTORY=D:\Media\Public Domain
# These paths are optional. Defaults are stored under backend\.data.
PD_STATE_FILE=D:\PROtv-Data\pd-ingestion-state.json
PD_POSTER_DIRECTORY=D:\PROtv-Data\posters
# Public backend origin used in stored poster URLs. Include /api when required by hosting.
PUBLIC_API_BASE_URL=http://localhost:5000
# Maximum time to wait for Mux to prepare one movie.
PD_TRANSCODE_TIMEOUT_MS=900000
# Optional web discovery limits. Defaults to 20 GB and backend\.data storage.
PD_WEB_MAX_FILE_BYTES=21474836480
PD_WEB_STATE_FILE=D:\PROtv-Data\pd-web-ingestion-state.json
# Automatic multi-source discovery runs once per day on a persistent backend.
PD_AUTO_DISCOVERY_ENABLED=true
PD_DISCOVERY_INTERVAL_MS=86400000
PD_CANDIDATE_STORE_FILE=D:\PROtv-Data\pd-candidates.json
# Optional. YouTube Creative Commons results are reference-only and are never downloaded.
YOUTUBE_API_KEY=your_youtube_data_api_key
# Optional Assistant overrides. The standard AI settings are used when omitted.
ADMIN_ASSISTANT_AI_BASE_URL=https://api.openai.com/v1
ADMIN_ASSISTANT_AI_API_KEY=your_ai_api_key
ADMIN_ASSISTANT_AI_MODEL=your_chat_model
# IANA time zone used for Administrator time questions.
ADMIN_TIME_ZONE=America/New_York

# OpenAI-compatible text generation used for descriptions, tags, and categories.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_ai_api_key
AI_MODEL=your_text_model

# Optional OpenAI-compatible image generation. A branded local poster is used when omitted.
AI_IMAGE_BASE_URL=https://api.openai.com/v1
AI_IMAGE_API_KEY=your_ai_image_api_key
AI_IMAGE_MODEL=your_image_model

# Distributor Ingestion Adapter
# The feed and all media/poster URLs in it must use HTTPS.
DISTRIBUTOR_FEED_URL=https://distributor.example.com/protv-feed.json
DISTRIBUTOR_FEED_TOKEN=your_bearer_token
DISTRIBUTOR_REQUIRED_TERRITORY=US
# Optional state location and Mux wait time.
DISTRIBUTOR_STATE_FILE=D:\PROtv-Data\distributor-ingestion-state.json
DISTRIBUTOR_TRANSCODE_TIMEOUT_MS=900000
